{
  "name": "ai-acquisition-search",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --experimental-test-module-mocks --test-concurrency=1 --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "backtest:decision": "tsx scripts/decision-backtest.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mobile:android:add": "cap add android",
    "mobile:android:sync": "cap sync android",
    "mobile:android:build": "cd android && ./gradlew bundleRelease",
    "mobile:ios:add": "cap add ios --packagemanager SPM",
    "mobile:ios:sync": "cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "@capacitor/android": "8.5.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
