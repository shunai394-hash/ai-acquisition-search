{
  "expo": {
    "name": "AI Acquisition Search",
    "slug": "ai-acquisition-search",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "aiacquisitionsearch",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ecpulse.aiacquisitionsearch",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ecpulse.aiacquisitionsearch",
      "adaptiveIcon": {
        "backgroundColor": "#080809",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080809",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "webAppUrl": "https://ai-acquisition-search.vercel.app"
    },
    "backgroundColor": "#080809",
    "primaryColor": "#080809",
    "icon": "./assets/icon.png"
  }
}
